{
  "name": "nudge-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "bind:local": "scripts/run-local-bind.sh",
    "check": "npm run check --workspaces --if-present",
    "check:handoff": "scripts/check-handoff-readiness.sh",
    "check:local-first": "scripts/check-local-first-readiness.sh",
    "check:relay-container": "scripts/check-relay-container.sh",
    "relay:local": "scripts/run-local-relay.sh",
    "relay:start": "npm --workspace @nudge/relay run start"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0"
  }
}
